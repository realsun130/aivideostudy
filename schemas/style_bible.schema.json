{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.animation-pipeline/style_bible.schema.json",
  "title": "StyleBible",
  "description": "Visual look lock only. Motion, transitions, and timing belong in shot_list / Bot D — not here.",
  "type": "object",
  "required": [
    "project_id",
    "version",
    "medium",
    "palette",
    "line",
    "lighting",
    "composition",
    "prompt_blocks",
    "negative_constraints",
    "likeness_rules",
    "defaults"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Bump on any lock change, e.g. 2026-10-13.2"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "One-paragraph human summary of the look"
    },
    "medium": {
      "type": "string",
      "enum": [
        "2d_illustration",
        "2d_cel",
        "watercolor",
        "pixel",
        "3d_stylized",
        "photoreal",
        "mixed",
        "other"
      ]
    },
    "medium_notes": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "required": [
        "primary",
        "background"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/color"
          }
        },
        "accent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          }
        },
        "background": {
          "$ref": "#/$defs/color"
        },
        "forbidden": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/color"
          },
          "description": "Colors that must not dominate"
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "weight",
        "style"
      ],
      "properties": {
        "weight": {
          "type": "string",
          "enum": [
            "none",
            "hairline",
            "thin",
            "medium",
            "bold",
            "variable"
          ]
        },
        "style": {
          "type": "string",
          "enum": [
            "clean",
            "sketchy",
            "ink",
            "painterly",
            "geometric",
            "soft"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "lighting": {
      "type": "object",
      "required": [
        "mood"
      ],
      "properties": {
        "mood": {
          "type": "string",
          "enum": [
            "flat",
            "soft_diffused",
            "high_key",
            "low_key",
            "dramatic",
            "neon",
            "natural",
            "other"
          ]
        },
        "direction": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "texture": {
      "type": "object",
      "properties": {
        "grain": {
          "type": "string",
          "enum": [
            "none",
            "subtle",
            "medium",
            "heavy"
          ]
        },
        "paper": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "typography": {
      "type": "object",
      "description": "Still-frame title/caption look if text appears in frames",
      "properties": {
        "title_font": {
          "type": "string"
        },
        "body_font": {
          "type": "string"
        },
        "title_color": {
          "$ref": "#/$defs/color"
        },
        "body_color": {
          "$ref": "#/$defs/color"
        },
        "stroke_color": {
          "$ref": "#/$defs/color"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "composition": {
      "type": "object",
      "description": "Still-frame framing language only — not motion or editing.",
      "required": [
        "preferred_framings"
      ],
      "properties": {
        "preferred_framings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "extreme_wide",
              "wide",
              "medium",
              "close_up",
              "extreme_close_up",
              "over_shoulder",
              "pov",
              "insert"
            ]
          }
        },
        "aspect_hints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. 9:16 poster, 16:9 board — crop for stills, not animation timing"
        },
        "layer_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paint/layer stack for still generation (bg → fg)"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "prompt_blocks": {
      "type": "object",
      "required": [
        "positive"
      ],
      "properties": {
        "positive": {
          "type": "string",
          "description": "Reusable positive style block for image models"
        },
        "character_lock": {
          "type": "string",
          "description": "Appended when generating characters"
        },
        "environment_lock": {
          "type": "string",
          "description": "Appended when generating scenes"
        }
      }
    },
    "negative_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Hard visual no's for generation and Bot E look checks"
    },
    "likeness_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Testable visual 'looks like this bible' rules"
    },
    "anchor_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "overall",
              "character",
              "environment",
              "color",
              "line",
              "typography",
              "other"
            ]
          },
          "notes": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "resolution"
      ],
      "description": "Still/output canvas defaults only. No motion presets.",
      "properties": {
        "resolution": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer"
            },
            "height": {
              "type": "integer"
            }
          }
        },
        "preview_label": {
          "type": "string"
        },
        "final_label": {
          "type": "string"
        }
      }
    },
    "preference_appendix": {
      "type": "object",
      "description": "Bot F distilled visual likes/dislikes",
      "properties": {
        "do": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dont": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_memory_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "locked_by": {
      "type": "string"
    },
    "measured_reference": {
      "type": "object",
      "description": "⚠️ 待测试 / 可选。从参考图实测的外观数字（见 docs/STYLE_AND_SHOT_SUMMARY.md「Style Bible 编写指南」）。只放画面外观，不放运动。",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "参与测量的参考图路径或编号"
        },
        "paper_rgb": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "最亮 8% 像素平均（纸色/底色）"
        },
        "ink_rgb": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "description": "最暗 1% 像素平均（墨色/最深色）"
        },
        "luminance_percentiles": {
          "type": "object",
          "properties": {
            "p10": {
              "type": "number"
            },
            "median": {
              "type": "number"
            },
            "p90": {
              "type": "number"
            }
          },
          "description": "亮度 0-255 的 p10 / 中位 / p90（可写区间字符串放 notes）"
        },
        "accents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "rgb": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 3,
                "maxItems": 3
              },
              "max_pixel_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "where": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          },
          "description": "强调色及其占画面像素上限（%）"
        },
        "value_ladder": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "depth": {
                "type": "string"
              },
              "tone_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tone_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "depth"
            ]
          },
          "description": "按景深的明度阶梯：tone 0=最深色 1=纸色"
        },
        "fake_tells": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "「看起来假」清单"
        },
        "comparison": {
          "type": "object",
          "properties": {
            "modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "side",
                  "compare",
                  "crop",
                  "sheet"
                ]
              }
            },
            "crops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "description": "逐区域对比参考图的方式与裁切区域"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "object",
      "required": [
        "hex"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "hex": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})$"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "accent",
            "bg",
            "text",
            "forbidden",
            "other"
          ]
        }
      }
    }
  }
}
