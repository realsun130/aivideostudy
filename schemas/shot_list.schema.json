{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.animation-pipeline/shot_list.schema.json",
  "title": "ShotList",
  "type": "object",
  "required": ["project_id", "version", "fps", "resolution", "shots"],
  "properties": {
    "project_id": { "type": "string" },
    "version": { "type": "string", "description": "e.g. 2026-10-13.1" },
    "fps": { "type": "integer", "enum": [24, 25, 30] },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "style_bible_ver": { "type": "string" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": [
        "shot_id",
        "duration_sec",
        "motion_preset",
        "frames",
        "transition_to_next"
      ],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^[A-Za-z0-9_\\-]+$" },
        "scene": { "type": "string" },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "action": { "type": "string" },
        "dialogue": { "type": "string" },
        "motion_preset": {
          "type": "string",
          "enum": [
            "static",
            "kenburns_in",
            "kenburns_out",
            "pan_left",
            "pan_right",
            "parallax",
            "punch_in",
            "subtitle_card"
          ]
        },
        "motion_params": {
          "type": "object",
          "description": "Preset-specific, e.g. {\"zoom\":[1.0,1.08], \"easing\":\"easeInOut\"}",
          "additionalProperties": true
        },
        "frames": {
          "type": "object",
          "required": ["hero"],
          "properties": {
            "hero": { "type": "string", "description": "Path relative to frames_root" },
            "bg": { "type": "string" },
            "char": { "type": "string" },
            "fx": { "type": "string" },
            "overlays": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "transition_to_next": {
          "type": "string",
          "enum": ["cut", "xfade", "fade_black"]
        },
        "transition_sec": { "type": "number", "minimum": 0 },
        "subtitle": { "type": "string" },
        "audio_cue": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
